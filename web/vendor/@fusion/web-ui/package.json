{
    "name": "@fusion/web-ui",
    "version": "0.1.0",
    "description": "Design tokens, Tailwind preset and shared components for fusion web modules",
    "license": "Apache-2.0",
    "type": "module",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./preset": "./src/preset.ts",
        "./tokens.css": "./src/tokens.css",
        "./format": "./src/format.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "bun run typecheck && bun build src/index.ts --outdir dist --target browser --format esm --external react --external react-dom"
    },
    "peerDependencies": {
        "react": "^18.3.0"
    },
    "devDependencies": {
        "@types/react": "^18.3.12",
        "react": "^18.3.1",
        "tailwindcss": "^3.4.14",
        "typescript": "^5.6.3"
    }
}
